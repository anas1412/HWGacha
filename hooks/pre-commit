#!/bin/sh
# Compress any staged image under images/ before it gets committed.
# Enable once per clone:  git config core.hooksPath hooks
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=AM -- 'images/*.jpg' 'images/*.jpeg' 'images/*.png' 'images/*.webp')
[ -z "$staged" ] && exit 0

command -v bun >/dev/null || { echo "pre-commit: bun not found (https://bun.sh)" >&2; exit 1; }
cd "$root" || exit 1
[ -d node_modules/sharp ] || bun install --silent || exit 1
bun run scripts/optimize-images.ts $staged || exit 1
git add $staged
